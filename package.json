{
  "name": "tsumizare",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run build:packages && vite",
    "build": "bun run build:packages && vite build",
    "preview": "NODE_ENV=production wrangler dev --local --port 8787",
    "test": "bun test packages",
    "typecheck": "bun run build:packages && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "format:unsafe": "biome check --write --unsafe .",
    "build:packages": "bun run --filter blocky-game build",
    "deploy": "bun run build && wrangler deploy",
    "test:e2e": "playwright test",
    "test:worker": "TEST_TARGET=worker playwright test"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "blocky-game": "workspace:*",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.554.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "satori": "^0.47.1",
    "tailwind-merge": "^3.4.0",
    "hono": "^4.12.8",
    "@yoshikouki/hono-file-router": "github:yoshikouki/hono-kit#f80daa6be994156fcc307dcc83b91558ad8caf5e",
    "@yoshikouki/hono-rsc-renderer": "github:yoshikouki/hono-kit#f80daa6be994156fcc307dcc83b91558ad8caf5e",
    "@fontsource-variable/inter": "^5.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@happy-dom/global-registrator": "^20.14.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "latest",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.1.0",
    "typescript": "^5",
    "vite": "^8.0.1",
    "@vitejs/plugin-rsc": "^0.5.21",
    "@vitejs/plugin-react": "^6.0.1",
    "@rolldown/plugin-babel": "^0.2.0",
    "@tailwindcss/vite": "^4.1.17",
    "wrangler": "^4.131.1",
    "@playwright/test": "^1.60.0"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "packageManager": "bun@1.3.14"
}
